---
source: src/frontend/tui/conversation_area.rs
expression: terminal.backend()
---
"┌Conversation──────────────────────────────────────────────┐"
"│Info:                                                     │"
"│  # Illustrious Manager                                   │"
"│                                                          │"
"│  - backend: vertex                                       │"
"│  - compaction.compaction_retain_count: 10                │"
"│  - compaction.compaction_role: default                   │"
"│  - compaction.compaction_threshold_percent: 80           │"
"│  - sessions_dir: /sessions                               │"
"│  - tools.bash_allowlist: cat, ls, grep, find, head, tail,│"
"│wc, tree                                                  │"
"│  - tools.bash_denylist: rm, wget, sudo, chmod, chown     │"
"│  - tools.confirmation: WriteOnly                         │"
"│  - tools.max_tool_iterations: 25                         │"
"│  - tools.sandbox_root: .                                 │"
"│  - vertex.model: claude-sonnet-4-20250514                │"
"│  - vertex.project: my-project                            │"
"│  - vertex.region: us-east5                               │"
"│                                                          │"
"└──────────────────────────────────────────────────────────┘"
